# Copy to .env and fill in. Never commit real secrets.
# Google Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Database target. Leave empty to use the bundled SQLite file (data/app.db).
# Postgres example (used automatically by docker compose):
# DATABASE_URL=postgresql+psycopg://app:app@db:5432/appdb
DATABASE_URL=

# Optional: limit how many models to list from the Gemini API.
GEMINI_MODEL_PAGE_SIZE=200
